  @@unique([mataPelajaranId, grupDaimiId])
  @@map("keaktifan_mapel_grup")
  @@schema("formal")
}

model NilaiFormal {
  id                String              @id @default(uuid())
  capaianKompetensi String?             @map("capaian_kompetensi")
  createdAt         DateTime            @default(now()) @map("created_at")
  kelasId           String              @map("kelas_id")
  mataPelajaranId   String              @map("mata_pelajaran_id")
  nilaiAkhir        Float?              @map("nilai_akhir")
  nilaiHarian       Float?              @map("nilai_harian")
  nilaiPas          Float?              @map("nilai_pas")
  predikat          String?
  riwayatKelasId    String?             @map("riwayat_kelas_id")
  semester          String
  studentId         String              @map("student_id")
  tahunAjaran       String              @map("tahun_ajaran")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  kelas             Kelas               @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  mataPelajaran     MataPelajaran       @relation(fields: [mataPelajaranId], references: [id], onDelete: Cascade)
  riwayatKelas      RiwayatKelasFormal? @relation(fields: [riwayatKelasId], references: [id])
  student           Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, mataPelajaranId, tahunAjaran, semester])
  @@map("nilai_formal")
  @@schema("formal")
}

model RiwayatKelasFormal {
  id                    String        @id @default(uuid())
  studentId             String        @map("student_id")
  kelasId               String        @map("kelas_id")
  tahunAjaran           String        @map("tahun_ajaran")
  semester              String
  statusAkhir           String?       @map("status_akhir")
  waliKelasId           String?       @map("wali_kelas_id")
  catatan               String?
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  alpa                  Int?          @default(0)
  catatanWaliKelas      String?       @map("catatan_wali_kelas")
  izin                  Int?          @default(0)
  sakit                 Int?          @default(0)
  disiplin              String?       @map("disiplin")
  hubunganSosial        String?       @map("hubungan_sosial")
  kemampuanRepresentasi String?       @map("kemampuan_representasi")
  kepercayaanDiri       String?       @map("kepercayaan_diri")
  kerapihan             String?       @map("kerapihan")
  ketaatan              String?       @map("ketaatan")
  ketakwaan             String?       @map("ketakwaan")
  semangatBelajar       String?       @map("semangat_belajar")
  tanggungJawab         String?       @map("tanggung_jawab")
  sudahCetak            Boolean       @default(false) @map("sudah_cetak")
  grupDaimiId           String?       @map("grup_daimi_id")
  nilaiFormal           NilaiFormal[]
  grupDaimi             GrupDaimi?    @relation(fields: [grupDaimiId], references: [id])
  kelas                 Kelas         @relation(fields: [kelasId], references: [id])
  student               Student       @relation(fields: [studentId], references: [id])
  waliKelas             Staff?        @relation(fields: [waliKelasId], references: [id])

  @@unique([studentId, tahunAjaran, semester])
  @@map("riwayat_kelas_formal")
  @@schema("formal")
}

model HafalanAlQuran {
  id            String   @id @default(uuid())
  studentId     String   @map("student_id")
  kelasId       String   @map("kelas_id")
  tahunAjaran   String   @map("tahun_ajaran")
  semester      String
  awalPutaran   Int?     @map("awal_putaran")
  awalJuz       Int?     @map("awal_juz")
  targetPutaran Int?     @map("target_putaran")
  targetJuz     Int?     @map("target_juz")
  akhirPutaran  Int?     @map("akhir_putaran")
  akhirJuz      Int?     @map("akhir_juz")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  kelas         Kelas    @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, tahunAjaran, semester])
  @@map("hafalan_al_quran")
  @@schema("formal")
}

model GuruMapelKelas {
  id              String        @id @default(uuid())
  staffId         String        @map("staff_id")
  mataPelajaranId String        @map("mata_pelajaran_id")
  kelasId         String        @map("kelas_id")
  kelas           Kelas         @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  mataPelajaran   MataPelajaran @relation(fields: [mataPelajaranId], references: [id], onDelete: Cascade)
  staff           Staff         @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, mataPelajaranId, kelasId])
  @@map("guru_mapel_kelas")
  @@schema("formal")
}

model PermohonanKelas {
  id                 String           @id @default(uuid())
  cabangId           String           @map("cabang_id")
  wilayahId          String           @map("wilayah_id")
  namaKelasUsulan    String           @map("nama_kelas_usulan")
  namaKelasDisetujui String?          @map("nama_kelas_disetujui")
  tingkat            String?
  tahunAjaran        String?          @map("tahun_ajaran")
  lembagaMuadalahId  String?          @map("lembaga_muadalah_id")
  waliKelasId        String?          @map("wali_kelas_id")
  ruangId            String?          @map("ruang_id")
  kurikulum          String?
  jurusan            String?
  kapasitas          Int?             @default(80)
  catatanAdmin       String?          @map("catatan_admin")
  status             StatusPermohonan @default(PENDING)
  createdById        String           @map("created_by_id")
  approvedById       String?          @map("approved_by_id")
  kelasCreatedId     String?          @map("kelas_created_id")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  approvedBy         User?            @relation("PermohonanKelasApprovedBy", fields: [approvedById], references: [id])
  cabang             Cabang           @relation(fields: [cabangId], references: [id])
  createdBy          User             @relation("PermohonanKelasCreatedBy", fields: [createdById], references: [id])
  wilayah            Wilayah          @relation(fields: [wilayahId], references: [id])

  @@map("permohonan_kelas")
  @@schema("formal")
}

// prisma/schema/kegiatan.prisma
model JenisKegiatan {
  id        String             @id @default(uuid())
  nama      String             @unique
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  templates TemplateKegiatan[]

  @@map("jenis_kegiatan")
  @@schema("core")
}

model TemplateKegiatan {
  id              String            @id @default(uuid())
  judul           String
  deskripsi       String
  deadline        DateTime
  jenisId         String            @map("jenis_id")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  tanggalKegiatan DateTime?         @map("tanggal_kegiatan")
  tujuanKegiatan  String?           @map("tujuan_kegiatan")
  waktuKegiatan   String?           @map("waktu_kegiatan")
  dokumen         DokumenTemplate[]
  kegiatan        Kegiatan[]
  jenis           JenisKegiatan     @relation(fields: [jenisId], references: [id])

  @@map("template_kegiatan")
  @@schema("core")
}

model DokumenTemplate {
  id         String           @id @default(uuid())
  templateId String           @map("template_id")
  filePath   String           @map("file_path")
  fileName   String           @map("file_name")
  fileType   String           @map("file_type")
  createdAt  DateTime         @default(now()) @map("created_at")
  template   TemplateKegiatan @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("dokumen_template")
  @@schema("core")
}

model Kegiatan {
  id                String            @id @default(uuid())
  templateId        String            @map("template_id")
  cabangId          String            @map("cabang_id")
  asramaId          String?           @map("asrama_id")
  deskripsi         String
  isConfirmed       Boolean           @default(false) @map("is_confirmed")
  confirmedAt       DateTime?         @map("confirmed_at")
  confirmedByUserId String?           @map("confirmed_by_user_id")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  jumlahPeserta     Int?              @map("jumlah_peserta")
  kesimpulan        String?           @map("kesimpulan")
  ringkasanKegiatan String?           @map("ringkasan_kegiatan")
  tanggalKegiatan   DateTime?         @map("tanggal_kegiatan")
  tempatKegiatan    String?           @map("tempat_kegiatan")
  waktuKegiatan     String?           @map("waktu_kegiatan")
  dokumen           DokumenKegiatan[]
  asrama            Ruang?            @relation(fields: [asramaId], references: [id])
  cabang            Cabang            @relation(fields: [cabangId], references: [id], onDelete: Cascade)
  confirmedByUser   User?             @relation(fields: [confirmedByUserId], references: [id])
  template          TemplateKegiatan  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  panitia           Panitia[]

  @@map("kegiatan")
  @@schema("core")
}

model Panitia {
  id         String   @id @default(uuid())
  kegiatanId String   @map("kegiatan_id")
  staffId    String   @map("staff_id")
  jabatan    String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  kegiatan   Kegiatan @relation(fields: [kegiatanId], references: [id], onDelete: Cascade)
  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("panitia")
  @@schema("core")
}

model DokumenKegiatan {
  id         String   @id @default(uuid())
  kegiatanId String   @map("kegiatan_id")
  filePath   String   @map("file_path")
  fileName   String   @map("file_name")
  fileType   String   @map("file_type")
  createdAt  DateTime @default(now()) @map("created_at")
  kegiatan   Kegiatan @relation(fields: [kegiatanId], references: [id], onDelete: Cascade)

  @@map("dokumen_kegiatan")
  @@schema("core")
}

// prisma/schema/pembelajaran.prisma
model SilabusMapel {
  id              String               @id @default(uuid())
  mataPelajaranId String               @map("mata_pelajaran_id")
  tingkat         String
  tahunAjaran     String               @map("tahun_ajaran")
  semester        String
  bab             String
  urutanBab       Int                  @map("urutan_bab")
  section         String
  urutanSection   Int                  @map("urutan_section")
  tanggalTarget   DateTime?            @map("tanggal_target") @db.Date
  isActive        Boolean              @default(true) @map("is_active")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  absensiMapel    AbsensiMapel[]
  pelaksanaan     PelaksanaanSilabus[]
  mataPelajaran   MataPelajaran        @relation(fields: [mataPelajaranId], references: [id], onDelete: Cascade)

  @@unique([mataPelajaranId, tingkat, tahunAjaran, semester, urutanBab, urutanSection])
  @@map("silabus_mapel")
  @@schema("formal")
}

model PelaksanaanSilabus {
  id              String        @id @default(uuid())
  silabusId       String?       @map("silabus_id")
  kelasId         String        @map("kelas_id")
  status          StatusSilabus @default(PENDING)
  tanggalDiajar   DateTime?     @map("tanggal_diajar") @db.Date
  catatan         String?
  updatedById     String?       @map("updated_by_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  guruId          String?       @map("guru_id")
  mataPelajaranId String        @map("mata_pelajaran_id")
  guru            Staff?        @relation(fields: [guruId], references: [id])
  kelas           Kelas         @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  mataPelajaran   MataPelajaran @relation(fields: [mataPelajaranId], references: [id], onDelete: Cascade)
  silabus         SilabusMapel? @relation(fields: [silabusId], references: [id], onDelete: Cascade)

  @@unique([kelasId, mataPelajaranId, tanggalDiajar])
  @@map("pelaksanaan_silabus")
  @@schema("formal")
}

model AbsensiMapel {
  id              String               @id @default(uuid())
  mataPelajaranId String               @map("mata_pelajaran_id")
  kelasId         String               @map("kelas_id")
  studentId       String               @map("student_id")
  tanggal         DateTime             @db.Date
  status          StatusKehadiranMapel @default(HADIR)
  catatan         String?
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  silabusId       String               @map("silabus_id")
  kelas           Kelas                @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  mataPelajaran   MataPelajaran        @relation(fields: [mataPelajaranId], references: [id], onDelete: Cascade)
  silabus         SilabusMapel         @relation(fields: [silabusId], references: [id], onDelete: Cascade)
  student         Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([silabusId, kelasId, studentId, tanggal])
  @@map("absensi_mapel")
  @@schema("formal")
}

enum StatusSilabus {
  PENDING
  COMPLETED
  LIBUR

  @@schema("formal")
}

enum StatusKehadiranMapel {
  HADIR
  SAKIT
  IZIN
  ALPA

  @@schema("formal")
}

// prisma/schema/pesantren.prisma
model Kamar {
  id   String @id @default(uuid())
  name String

  @@map("kamar")
  @@schema("pesantren")
}

model GrupDaimi {
  id                 String               @id @default(uuid())
  name               String
  jenis              String?
  ketuaId            String?              @map("ketua_id")
  cabangId           String?              @map("cabang_id")
  staff              Staff[]
  keaktifanMapelGrup KeaktifanMapelGrup[]
  riwayatKelasFormal RiwayatKelasFormal[]
  dataDaimi          DataDaimi[]
  cabang             Cabang?              @relation("GrupDaimiCabang", fields: [cabangId], references: [id])
  ketua              Staff?               @relation("GrupDaimiKetua", fields: [ketuaId], references: [id])
  kelasDaimi         KelasDaimi[]

  @@map("grup_daimi")
  @@schema("pesantren")
}

model JenisGrupDaimi {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("jenis_grup_daimi")
  @@schema("pesantren")
}

model KelasDaimi {
  id        String      @id @default(uuid())
  name      String
  grupId    String      @map("grup_id")
  wilayahId String?     @map("wilayah_id")
  cabangId  String?     @map("cabang_id")
  dataDaimi DataDaimi[]
  cabang    Cabang?     @relation(fields: [cabangId], references: [id])
  grup      GrupDaimi   @relation(fields: [grupId], references: [id], onDelete: Cascade)
  wilayah   Wilayah?    @relation(fields: [wilayahId], references: [id])

  @@map("kelas_daimi")
  @@schema("pesantren")
}

model DataDaimi {
  id        String      @id @default(uuid())
  studentId String      @unique @map("student_id")
  grupId    String?     @map("grup_id")
  kelasId   String?     @map("kelas_id")
  nis       String?     @map("nis")
  grup      GrupDaimi?  @relation(fields: [grupId], references: [id])
  kelas     KelasDaimi? @relation(fields: [kelasId], references: [id])
  student   Student     @relation(fields: [studentId], references: [id])

  @@map("data_daimi")
  @@schema("pesantren")
}

model NilaiKitab {
  id    String @id @default(uuid())
  score Float

  @@map("nilai_kitab")
  @@schema("pesantren")
}

// prisma/schema/sarpras.prisma
model Ruang {
  id         String      @id @default(uuid())
  nama       String
  kode       String?
  tipe       String
  kapasitas  Int?
  luas       Float?
  kondisi    String
  keterangan String?
  cabangId   String      @map("cabang_id")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  fasilitas  Fasilitas[]
  kegiatan   Kegiatan[]
  cabang     Cabang      @relation(fields: [cabangId], references: [id], onDelete: Cascade)
  kelas      Kelas[]

  @@map("ruang")
  @@schema("core")
}

model Fasilitas {
  id         String   @id @default(uuid())
  nama       String
  kode       String?
  jumlah     Int
  kondisi    String
  keterangan String?
  cabangId   String   @map("cabang_id")
  ruangId    String?  @map("ruang_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  cabang     Cabang   @relation(fields: [cabangId], references: [id], onDelete: Cascade)
  ruang      Ruang?   @relation(fields: [ruangId], references: [id])

  @@map("fasilitas")
  @@schema("core")
}


