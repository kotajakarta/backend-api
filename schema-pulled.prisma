  fotoKelas                 String?               @map("foto_kelas")
  fotoRuangTidur            String?               @map("foto_ruang_tidur")
  fotoRuangMakan            String?               @map("foto_ruang_makan")
  fotoKamarMandi            String?               @map("foto_kamar_mandi")
  wilayah                   Wilayah?              @relation(fields: [wilayahId], references: [id])
  fasilitas                 Fasilitas[]
  kegiatan                  Kegiatan[]
