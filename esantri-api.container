[Unit]
Description=Edaimi Backend API (Rootless)
After=network-online.target

[Container]
# Menggunakan image Node.js
Image=docker.io/library/node:22-alpine
WorkingDir=/app

# Mengeset nama container agar bisa dipanggil oleh cloudflared tunnel
ContainerName=esantri-api

# Menghubungkan container langsung ke jaringan Podman 'global_net'
Network=global_net

# 1. Mount kode aplikasi sebagai READ-ONLY (:ro,Z) untuk keamanan
Volume=/webku/appsku/esantri/backend-api:/app:ro,Z

# 2. [Opsional] Un-comment jika API ini juga menangani upload berkas di root /app/uploads

Volume=/webku/appsku/esantri/backend-api/uploads:/app/uploads:Z

# Menjalankan backend API
Exec=node dist/main.js

# Batas memori container: mencegah satu proses yang leak/bocor menghabiskan
# RAM seluruh host. --max-old-space-size diset di bawah batas container agar
# V8 melakukan GC/OOM lebih dulu daripada kernel mematikan container secara paksa.
#
# Cluster mode: menjalankan 4 proses worker (dari 12 core yang tersedia) agar
# API tidak lagi terpaku di 1 core.
#
# CATATAN (28 Sep 2026): --max-old-space-size sempat diset 768MB dengan asumsi
# 4 worker x 768MB muat di Memory=4g. Ternyata 768MB kekecilan untuk beban
# riil satu worker saat jam sibuk -> worker crash "JavaScript heap out of
# memory" (SIGABRT) di tengah trafik nyata, menjatuhkan semua koneksi yang
# sedang ditanganinya. Dikembalikan ke 1536MB (nilai yang sebelumnya terbukti
# aman saat masih 1 proses), dan Memory= dinaikkan ke 8g supaya 4 worker x
# 1536MB (~6GB heap ceiling) + overhead native (buffer Sharp/MinIO/pg per
# worker) tetap punya headroom. Host punya 57GB RAM (~45GB free) tapi dipakai
# bersama aplikasi lain, jadi 8g dipilih secukupnya, bukan maksimal host.
Memory=8g
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=1536
Environment=CLUSTER_WORKERS=4
Environment=DATABASE_POOL_MAX=5

# Menggunakan berkas environment host RHEL
EnvironmentFile=%h/.secrets/esantri.secret

# === SEKSI HEALTH CHECK ===
HealthCmd=node --input-type=module -e "import http from 'http'; http.get('http://localhost:8080/api/v1/health', (r) => { if (r.statusCode === 200) process.exit(0); else process.exit(1); }).on('error', () => process.exit(1));"
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=10s

[Install]
WantedBy=default.target
