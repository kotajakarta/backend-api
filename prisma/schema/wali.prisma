enum JenisIzinSantri {
  IZIN_PULANG
  SAKIT
  LAINNYA

  @@schema("core")
}

model WaliSantri {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  studentId String           @map("student_id")
  hubungan  String?
  status    StatusPermohonan @default(APPROVED)
  createdAt DateTime         @default(now()) @map("created_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([userId, studentId])
  @@map("wali_santri")
  @@schema("core")
}

model PermohonanIzinSantri {
  id             String           @id @default(uuid())
  studentId      String           @map("student_id")
  createdById    String           @map("created_by_id")
  jenisIzin      JenisIzinSantri  @map("jenis_izin")
  keterangan     String
  tanggalMulai   DateTime         @map("tanggal_mulai") @db.Date
  tanggalSelesai DateTime         @map("tanggal_selesai") @db.Date
  status         StatusPermohonan @default(PENDING)
  catatanAdmin   String?          @map("catatan_admin")
  approvedById   String?          @map("approved_by_id")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdBy      User             @relation("PermohonanIzinCreatedBy", fields: [createdById], references: [id])
  approvedBy     User?            @relation("PermohonanIzinApprovedBy", fields: [approvedById], references: [id])

  @@map("permohonan_izin_santri")
  @@schema("core")
}

enum CctvCategory {
  KELAS
  MASJID
  MAKAN
  ASRAMA
  HALAMAN
  LAINNYA

  @@schema("core")
}

model CctvChannel {
  id          String       @id @default(uuid())
  cabangId    String       @map("cabang_id")
  name        String
  category    CctvCategory @default(KELAS)
  streamUrl   String       @map("stream_url")
  location    String?
  description String?
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  cabang      Cabang       @relation(fields: [cabangId], references: [id], onDelete: Cascade)

  @@map("cctv_channels")
  @@schema("core")
}

model PengumumanWalsan {
  id          String   @id @default(uuid())
  title       String
  content     String
  links       Json?
  scope       String   @default("GLOBAL") // "GLOBAL" (Pusat) atau "CABANG"
  cabangId    String?  @map("cabang_id")
  createdById String?  @map("created_by_id")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  cabang      Cabang?  @relation(fields: [cabangId], references: [id], onDelete: Cascade)
  createdBy   User?    @relation("PengumumanWalsanCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@map("pengumuman_walsan")
  @@schema("core")
}

enum KategoriTagihan {
  BULANAN
  TAHUNAN
  SANTRI_BARU
  LAINNYA

  @@schema("core")
}

enum StatusTagihan {
  LUNAS
  PENDING
  BELUM_LUNAS

  @@schema("core")
}

enum MetodePembayaran {
  TRANSFER
  TUNAI
  QRIS

  @@schema("core")
}

model SyahriyahTarif {
  id          String          @id @default(uuid())
  name        String
  kategori    KategoriTagihan @default(BULANAN)
  nominal     Float           @default(0)
  cabangId    String?         @map("cabang_id")
  tahunAjaran String?         @map("tahun_ajaran")
  tingkat     String?
  deskripsi   String?
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  cabang  Cabang?         @relation(fields: [cabangId], references: [id], onDelete: Cascade)
  tagihan TagihanSantri[]

  @@map("syahriyah_tarif")
  @@schema("core")
}

model RekeningPembayaran {
  id            String   @id @default(uuid())
  bankName      String   @map("bank_name")
  nomorRekening String   @map("nomor_rekening")
  atasNama      String   @map("atas_nama")
  cabangId      String?  @map("cabang_id")
  qrisUrl       String?  @map("qris_url")
  catatan       String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  cabang Cabang? @relation(fields: [cabangId], references: [id], onDelete: Cascade)

  @@map("rekening_pembayaran")
  @@schema("core")
}

model TagihanSantri {
  id         String          @id @default(uuid())
  studentId  String          @map("student_id")
  tarifId    String?         @map("tarif_id")
  cabangId   String?         @map("cabang_id")
  judul      String
  kategori   KategoriTagihan @default(BULANAN)
  bulan      Int?
  tahun      Int             @default(2026)
  nominal    Float           @default(0)
  sisaBayar  Float           @default(0) @map("sisa_bayar")
  status     StatusTagihan   @default(BELUM_LUNAS)
  jatuhTempo DateTime?       @map("jatuh_tempo")
  keterangan String?
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  student    Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tarif      SyahriyahTarif?    @relation(fields: [tarifId], references: [id], onDelete: SetNull)
  cabang     Cabang?            @relation(fields: [cabangId], references: [id], onDelete: SetNull)
  pembayaran PembayaranSantri[]

  @@map("tagihan_santri")
  @@schema("core")
}

model PembayaranSantri {
  id           String           @id @default(uuid())
  tagihanId    String           @map("tagihan_id")
  studentId    String           @map("student_id")
  waliUserId   String?          @map("wali_user_id")
  nominal      Float            @default(0)
  tanggalBayar DateTime         @default(now()) @map("tanggal_bayar")
  metode       MetodePembayaran @default(TRANSFER)
  buktiUrl     String?          @map("bukti_url")
  status       StatusTagihan    @default(PENDING)
  catatanWali  String?          @map("catatan_wali")
  catatanAdmin String?          @map("catatan_admin")
  verifiedById String?          @map("verified_by_id")
  verifiedAt   DateTime?        @map("verified_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  tagihan    TagihanSantri @relation(fields: [tagihanId], references: [id], onDelete: Cascade)
  student    Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  waliUser   User?         @relation("PembayaranWaliUser", fields: [waliUserId], references: [id], onDelete: SetNull)
  verifiedBy User?         @relation("PembayaranVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@map("pembayaran_santri")
  @@schema("core")
}
