enum StatusSilabus {
  PENDING
  COMPLETED
  LIBUR

  @@schema("formal")
}

enum StatusKehadiranMapel {
  HADIR
  SAKIT
  IZIN
  ALPA

  @@schema("formal")
}

model SilabusMapel {
  id              String   @id @default(uuid())
  mataPelajaranId String   @map("mata_pelajaran_id")
  tingkat         String
  tahunAjaran     String   @map("tahun_ajaran")
  semester        String
  bab             String
  urutanBab       Int      @map("urutan_bab")
  section         String
  urutanSection   Int      @map("urutan_section")
  tanggalTarget   DateTime? @map("tanggal_target") @db.Date
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  mataPelajaran MataPelajaran        @relation(fields: [mataPelajaranId], references: [id], onDelete: Cascade)
  pelaksanaan   PelaksanaanSilabus[]
  absensiMapel  AbsensiMapel[]

  @@unique([mataPelajaranId, tingkat, tahunAjaran, semester, urutanBab, urutanSection])
  @@map("silabus_mapel")
  @@schema("formal")
}

// silabusId boleh kosong: baris tanpa silabusId adalah penanda "Libur" murni untuk satu
// tanggal + mapel di satu kelas, tidak terikat ke section manapun (mis. libur nasional) —
// beda dari status LIBUR pada section yang sudah dijadwalkan (yang tetap punya silabusId).
model PelaksanaanSilabus {
  id              String        @id @default(uuid())
  silabusId       String?       @map("silabus_id")
  mataPelajaranId String        @map("mata_pelajaran_id")
  kelasId         String        @map("kelas_id")
  guruId          String?       @map("guru_id")
  status          StatusSilabus @default(PENDING)
  tanggalDiajar   DateTime?     @map("tanggal_diajar") @db.Date
  catatan         String?
  updatedById     String?       @map("updated_by_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  silabus       SilabusMapel? @relation(fields: [silabusId], references: [id], onDelete: Cascade)
  mataPelajaran MataPelajaran @relation(fields: [mataPelajaranId], references: [id], onDelete: Cascade)
  kelas         Kelas          @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  guru          Staff?         @relation(fields: [guruId], references: [id])

  @@unique([kelasId, mataPelajaranId, tanggalDiajar])
  @@map("pelaksanaan_silabus")
  @@schema("formal")
}

// Absensi per baris silabus: satu baris = kehadiran satu siswa untuk satu materi/section
// (silabusId) yang diajarkan di satu kelas pada tanggal tertentu.
model AbsensiMapel {
  id              String               @id @default(uuid())
  silabusId       String               @map("silabus_id")
  mataPelajaranId String               @map("mata_pelajaran_id")
  kelasId         String               @map("kelas_id")
  studentId       String               @map("student_id")
  tanggal         DateTime             @db.Date
  status          StatusKehadiranMapel @default(HADIR)
  catatan         String?
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  silabus       SilabusMapel  @relation(fields: [silabusId], references: [id], onDelete: Cascade)
  mataPelajaran MataPelajaran @relation(fields: [mataPelajaranId], references: [id], onDelete: Cascade)
  kelas         Kelas         @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([mataPelajaranId, kelasId, studentId, tanggal])
  @@map("absensi_mapel")
  @@schema("formal")
}

model RekapPembelajaran {
  id              String   @id @default(uuid())
  tahunAjaran     String   @map("tahun_ajaran")
  semester        String
  periodeTipe     String   @map("periode_tipe") // 'MONTHLY' | 'WEEKLY' | 'SEMESTER'
  periodeKey      String   @map("periode_key")  // '2026-08' | '2026-W35' | '2026/2027-1'
  
  // Hirarki Unit
  unitLevel       String   @map("unit_level")   // 'GLOBAL' | 'WILAYAH' | 'CABANG' | 'KELAS'
  unitId          String   @map("unit_id")      // ID Wilayah, Cabang, Kelas, atau 'GLOBAL'
  unitName        String   @map("unit_name")
  parentName      String?  @map("parent_name")  // Nama Wilayah jika unitLevel Cabang
  
  // Filter Opsional
  mataPelajaranId String   @default("ALL") @map("mata_pelajaran_id") // 'ALL' jika agregat semua mapel
  
  // Metrik Agregat
  jumlahCabang    Int      @default(0) @map("jumlah_cabang")
  jumlahKelas     Int      @default(0) @map("jumlah_kelas")
  jumlahSiswa     Int      @default(0) @map("jumlah_siswa")
  mapelTerlaksana Int      @default(0) @map("mapel_terlaksana")
  mapelTarget     Int      @default(0) @map("mapel_target")
  persenMapel     Float    @default(0) @map("persen_mapel")
  totalHadir      Int      @default(0) @map("total_hadir")
  totalAbsensi    Int      @default(0) @map("total_absensi")
  persenKehadiran Float    @default(0) @map("persen_kehadiran")
  
  // Rincian Mingguan (JSON cache untuk kolom Sabtu 1..N)
  weeksJson       Json?    @map("weeks_json")
  
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([tahunAjaran, semester, periodeTipe, periodeKey, unitLevel, unitId, mataPelajaranId])
  @@index([tahunAjaran, semester, periodeTipe, periodeKey])
  @@index([unitLevel, unitId])
  @@map("rekap_pembelajaran")
  @@schema("formal")
}

