enum QuestionType {
  MCQ_4      // Pilihan Ganda (A-D)
  MCQ_5      // Pilihan Ganda (A-E)
  ESSAY      // Soal Uraian / Esai
  COMPLEX_MC // Pilihan Ganda Kompleks
  TRUE_FALSE // Benar / Salah

  @@map("question_type")
  @@schema("bank_soal")
}

enum ProjectStatus {
  DRAFT
  AKTIF
  SELESAI
  DITUTUP

  @@map("project_status")
  @@schema("bank_soal")
}

enum AssignmentStatus {
  MENUNGGU_DELEGASI_CABANG // Admin Pusat menugaskan ke Wilayah, menunggu Wilayah menugaskan ke Cabang
  MENUNGGU_PENUGASAN_GURU  // Wilayah menugaskan ke Cabang, menunggu Cabang menugaskan ke Guru
  DITUGASKAN               // Cabang menugaskan ke Guru
  DALAM_PROSES             // Guru sedang membuat/mengedit soal
  SELESAI                  // Guru menandai selesai
  DISETUJUI                // Cabang / Wilayah / Pusat menyetujui

  @@map("assignment_status")
  @@schema("bank_soal")
}

model QuestionBank {
  id           String              @id @default(uuid())
  title        String
  subject      String
  gradeLevel   String              @map("grade_level")
  timeLimit    Int?                @map("time_limit")
  institution  String?
  academicYear String?             @map("academic_year")
  semester     String?
  instructions String?             @db.Text
  
  // Ownership Guru & Cabang
  teacherId    String              @map("teacher_id")
  teacher      User                @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  cabangId     String?             @map("cabang_id")
  cabang       Cabang?             @relation(fields: [cabangId], references: [id], onDelete: SetNull)
  isShared     Boolean             @default(false) @map("is_shared")

  assignment   BankSoalAssignment?
  questions    QuestionItem[]

  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  @@index([teacherId])
  @@index([cabangId])
  @@map("question_banks")
  @@schema("bank_soal")
}

model QuestionItem {
  id             String           @id @default(uuid())
  questionBankId String           @map("question_bank_id")
  questionBank   QuestionBank     @relation(fields: [questionBankId], references: [id], onDelete: Cascade)
  type           QuestionType     @default(MCQ_4)
  contentHtml    String           @db.Text @map("content_html")
  answerKey      String?          @db.Text @map("answer_key")
  orderIndex     Int              @default(0) @map("order_index")
  weight         Float?           @default(1)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  options        QuestionOption[]

  @@index([questionBankId])
  @@map("question_items")
  @@schema("bank_soal")
}

model QuestionOption {
  id             String       @id @default(uuid())
  questionItemId String       @map("question_item_id")
  questionItem   QuestionItem @relation(fields: [questionItemId], references: [id], onDelete: Cascade)
  label          String       // 'A', 'B', 'C', 'D', 'E'
  contentHtml    String       @db.Text @map("content_html")
  isCorrect      Boolean      @default(false) @map("is_correct")
  orderIndex     Int          @default(0) @map("order_index")

  @@index([questionItemId])
  @@map("question_options")
  @@schema("bank_soal")
}

model BankSoalProject {
  id           String               @id @default(uuid())
  title        String
  description  String?              @db.Text
  academicYear String?              @map("academic_year")
  semester     String?
  deadline     DateTime?
  status       ProjectStatus        @default(AKTIF)
  createdById  String               @map("created_by_id")
  createdBy    User                 @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  assignments  BankSoalAssignment[]

  @@index([createdById])
  @@map("bank_soal_projects")
  @@schema("bank_soal")
}

model BankSoalAssignment {
  id               String           @id @default(uuid())
  projectId        String           @map("project_id")
  project          BankSoalProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subjectId        String?          @map("subject_id")
  subjectName      String           @map("subject_name")
  gradeLevel       String           @map("grade_level")
  targetMcqCount   Int              @default(40) @map("target_mcq_count")
  targetEssayCount Int              @default(5) @map("target_essay_count")
  timeLimit        Int?             @map("time_limit")
  instructions     String?          @db.Text

  // Hirarki Penugasan: Global -> Wilayah -> Cabang -> Guru
  wilayahId        String?          @map("wilayah_id")
  wilayah          Wilayah?         @relation(fields: [wilayahId], references: [id], onDelete: SetNull)
  cabangId         String?          @map("cabang_id")
  cabang           Cabang?          @relation(fields: [cabangId], references: [id], onDelete: SetNull)
  teacherId        String?          @map("teacher_id")
  teacher          User?            @relation("AssignmentTeacher", fields: [teacherId], references: [id], onDelete: SetNull)

  // Tautan ke paket QuestionBank hasil pengerjaan
  questionBankId   String?          @unique @map("question_bank_id")
  questionBank     QuestionBank?    @relation(fields: [questionBankId], references: [id], onDelete: SetNull)

  status           AssignmentStatus @default(MENUNGGU_DELEGASI_CABANG)
  notes            String?          @db.Text
  
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([wilayahId])
  @@index([cabangId])
  @@index([teacherId])
  @@map("bank_soal_assignments")
  @@schema("bank_soal")
}
