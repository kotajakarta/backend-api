model SiswaFormal {
  id        String  @id @default(uuid())
  studentId String  @unique @map("student_id")
  kelasId   String? @map("kelas_id")
  tingkat   String? @map("tingkat")
  nis       String? @map("nis")
  nisn      String? @unique
  isVerval  Boolean @default(false) @map("is_verval")
  kelas     Kelas?  @relation(fields: [kelasId], references: [id])
  student   Student @relation(fields: [studentId], references: [id])

  @@map("siswa_formal")
  @@schema("formal")
}

model Kelas {
  id                 String               @id @default(uuid())
  name               String
  tingkat            String?
  isActive           Boolean              @default(true) @map("is_active")
  cabangId           String?              @map("cabang_id")
  lembagaMuadalahId  String?              @map("lembaga_muadalah_id")
  tahunAjaran        String?              @map("tahun_ajaran")
  waliKelasId        String?              @map("wali_kelas_id")
  ruangId            String?              @map("ruang_id")
  kurikulum          String?              @map("kurikulum")
  jurusan            String?              @map("jurusan")
  jenisRombel        String?              @map("jenis_rombel")
  kapasitas          Int?                 @default(80) @map("kapasitas")
  guruMapelKelas     GuruMapelKelas[]
  cabang             Cabang?              @relation(fields: [cabangId], references: [id])
  lembagaMuadalah    LembagaMuadalah?     @relation(fields: [lembagaMuadalahId], references: [id])
  waliKelas          Staff?               @relation("KelasWali", fields: [waliKelasId], references: [id])
  ruang              Ruang?               @relation(fields: [ruangId], references: [id])
  riwayatKelasFormal RiwayatKelasFormal[]
  siswaFormal        SiswaFormal[]
  nilaiFormal        NilaiFormal[]
  hafalanAlQuran     HafalanAlQuran[]
  pelaksanaanSilabus PelaksanaanSilabus[]
  absensiMapel       AbsensiMapel[]

  @@map("kelas")
  @@schema("formal")
}

model LembagaMuadalah {
  id                      String   @id @default(uuid())
  name                    String
  code                    String   @unique
  npsn                    String?
  nspp                    String?
  pesantrenInduk          String?  @map("pesantren_induk")
  tahunBerdiri            String?  @map("tahun_berdiri")
  namaKetua               String?  @map("nama_ketua")
  operator                String?  @map("operator")
  emisPontren             String?  @map("emis_pontren")
  emisPontrenPass         String?  @map("emis_pontren_pass")
  emisSpm                 String?  @map("emis_spm")
  emisSpmPass             String?  @map("emis_spm_pass")
  ttdKetua                String?  @map("ttd_ketua")
  skSpm                   String?  @map("sk_spm")
  skStruktur              String?  @map("sk_struktur")
  skDewanMasyayikh        String?  @map("sk_dewan_masyayikh")
  skPengangkatanKepalaSpm String?  @map("sk_pengangkatan_kepala_spm")
  isActive                Boolean  @default(true) @map("is_active")
  namaLain                String?  @map("nama_lain")
  jenjang                 String?  // ULA, WUSTHA, ULYA
  provinsi                String?
  kabupaten               String?
  kecamatan               String?
  kelurahan               String?
  alamatDetail            String?  @map("alamat_detail")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")
  kelas                   Kelas[]

  @@map("lembaga_muadalah")
  @@schema("formal")
}

model MataPelajaran {
  id             String               @id @default(uuid())
  name           String
  grupMapel      String               @map("grup_mapel")
  isActive       Boolean              @default(true) @map("is_active")
  aktifPembelajaran Boolean           @default(true) @map("aktif_pembelajaran")
  kodeMapel      String               @unique @map("kode_mapel")
  guruMapelKelas GuruMapelKelas[]
  keaktifanGrup  KeaktifanMapelGrup[]
  nilaiFormal    NilaiFormal[]
  silabusMapel   SilabusMapel[]
  absensiMapel   AbsensiMapel[]
  pelaksanaanLibur PelaksanaanSilabus[]

  @@map("mata_pelajaran")
  @@schema("formal")
}

model KeaktifanMapelGrup {
  id              String        @id @default(uuid())
  mataPelajaranId String        @map("mata_pelajaran_id")
  grupDaimiId     String        @map("grup_daimi_id")
  isActive        Boolean       @default(false) @map("is_active")
  grupDaimi       GrupDaimi     @relation(fields: [grupDaimiId], references: [id], onDelete: Cascade)
  mataPelajaran   MataPelajaran @relation(fields: [mataPelajaranId], references: [id], onDelete: Cascade)

  @@unique([mataPelajaranId, grupDaimiId])
  @@map("keaktifan_mapel_grup")
  @@schema("formal")
}

model NilaiFormal {
  id                String              @id @default(uuid())
  studentId         String              @map("student_id")
  mataPelajaranId   String              @map("mata_pelajaran_id")
  kelasId           String              @map("kelas_id")
  riwayatKelasId    String?             @map("riwayat_kelas_id")
  tahunAjaran       String              @map("tahun_ajaran")
  semester          String              // Ganjil / Genap
  nilaiHarian       Float?              @map("nilai_harian") // Formatif / TP
  nilaiPas          Float?              @map("nilai_pas")    // Sumatif Akhir Semester / PAS
  nilaiAkhir        Float?              @map("nilai_akhir")  // Rapor 0-100
  predikat          String?             // A, B, C, D
  capaianKompetensi String?             @map("capaian_kompetensi") // Deskripsi capaian Kemenag
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  student           Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mataPelajaran     MataPelajaran       @relation(fields: [mataPelajaranId], references: [id], onDelete: Cascade)
  kelas             Kelas               @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  riwayatKelas      RiwayatKelasFormal? @relation(fields: [riwayatKelasId], references: [id], onDelete: SetNull)

  @@unique([studentId, mataPelajaranId, tahunAjaran, semester])
  @@map("nilai_formal")
  @@schema("formal")
}

model RiwayatKelasFormal {
  id               String        @id @default(uuid())
  studentId        String        @map("student_id")
  kelasId          String        @map("kelas_id")
  tahunAjaran      String        @map("tahun_ajaran")
  semester         String
  statusAkhir      String?       @map("status_akhir")
  waliKelasId      String?       @map("wali_kelas_id")
  catatan          String?
  catatanWaliKelas String?       @map("catatan_wali_kelas")
  ketakwaan             String? @map("ketakwaan")               // Predikat: A, B+, B, C+, C
  ketaatan              String? @map("ketaatan")
  kemampuanRepresentasi String? @map("kemampuan_representasi")
  kerapihan             String? @map("kerapihan")
  kepercayaanDiri       String? @map("kepercayaan_diri")
  hubunganSosial        String? @map("hubungan_sosial")
  semangatBelajar       String? @map("semangat_belajar")
  disiplin              String? @map("disiplin")
  tanggungJawab         String? @map("tanggung_jawab")
  sakit            Int?          @default(0)
  izin             Int?          @default(0)
  alpa             Int?          @default(0)
  sudahCetak       Boolean       @default(false) @map("sudah_cetak")
  grupDaimiId      String?       @map("grup_daimi_id")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  kelas            Kelas         @relation(fields: [kelasId], references: [id])
  student          Student       @relation(fields: [studentId], references: [id])
  waliKelas        Staff?        @relation(fields: [waliKelasId], references: [id])
  grupDaimi        GrupDaimi?    @relation(fields: [grupDaimiId], references: [id])
  nilaiFormal      NilaiFormal[]

  @@unique([studentId, tahunAjaran, semester])
  @@map("riwayat_kelas_formal")
  @@schema("formal")
}

model HafalanAlQuran {
  id           String   @id @default(uuid())
  studentId    String   @map("student_id")
  kelasId      String   @map("kelas_id")
  tahunAjaran  String   @map("tahun_ajaran")
  semester     String
  awalPutaran  Int?     @map("awal_putaran")
  awalJuz      Int?     @map("awal_juz")
  targetPutaran Int?    @map("target_putaran")
  targetJuz    Int?     @map("target_juz")
  akhirPutaran Int?     @map("akhir_putaran")
  akhirJuz     Int?     @map("akhir_juz")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  kelas        Kelas    @relation(fields: [kelasId], references: [id], onDelete: Cascade)

  @@unique([studentId, tahunAjaran, semester])
  @@map("hafalan_al_quran")
  @@schema("formal")
}

model GuruMapelKelas {
  id              String        @id @default(uuid())
  staffId         String        @map("staff_id")
  mataPelajaranId String        @map("mata_pelajaran_id")
  kelasId         String        @map("kelas_id")
  kelas           Kelas         @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  mataPelajaran   MataPelajaran @relation(fields: [mataPelajaranId], references: [id], onDelete: Cascade)
  staff           Staff         @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, mataPelajaranId, kelasId])
  @@map("guru_mapel_kelas")
  @@schema("formal")
}

model PermohonanKelas {
  id                 String           @id @default(uuid())
  cabangId           String           @map("cabang_id")
  wilayahId          String           @map("wilayah_id")
  namaKelasUsulan    String           @map("nama_kelas_usulan")
  namaKelasDisetujui String?          @map("nama_kelas_disetujui")
  tingkat            String?
  tahunAjaran        String?          @map("tahun_ajaran")
  lembagaMuadalahId  String?          @map("lembaga_muadalah_id")
  waliKelasId        String?          @map("wali_kelas_id")
  ruangId            String?          @map("ruang_id")
  kurikulum          String?
  jurusan            String?
  kapasitas          Int?             @default(80)
  catatanAdmin       String?          @map("catatan_admin")
  status             StatusPermohonan @default(PENDING)
  createdById        String           @map("created_by_id")
  approvedById       String?          @map("approved_by_id")
  kelasCreatedId     String?          @map("kelas_created_id")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  cabang             Cabang           @relation(fields: [cabangId], references: [id])
  wilayah            Wilayah          @relation(fields: [wilayahId], references: [id])
  createdBy          User             @relation("PermohonanKelasCreatedBy", fields: [createdById], references: [id])
  approvedBy         User?            @relation("PermohonanKelasApprovedBy", fields: [approvedById], references: [id])

  @@map("permohonan_kelas")
  @@schema("formal")
}

model KomparasiEmisBatch {
  id                 String          @id @default(uuid())
  executedAt         DateTime        @default(now()) @map("executed_at")
  executedById       String?         @map("executed_by_id")
  totalSantriEsantri Int             @default(0) @map("total_santri_esantri")
  totalTerdaftarEmis Int             @default(0) @map("total_terdaftar_emis")
  totalBelumEmis     Int             @default(0) @map("total_belum_emis")
  totalVervalOk      Int             @default(0) @map("total_verval_ok")
  totalResiduVerval  Int             @default(0) @map("total_residu_verval")
  totalBelumVerval   Int             @default(0) @map("total_belum_verval")
  totalDiskrepansi   Int             @default(0) @map("total_diskrepansi")
  totalButuhTindakan Int             @default(0) @map("total_butuh_tindakan")
  cabangBreakdown    Json            @map("cabang_breakdown")
  catatan            String?
  createdAt          DateTime        @default(now()) @map("created_at")

  details            KomparasiEmis[]

  @@map("komparasi_emis_batch")
  @@schema("formal")
}

model KomparasiEmis {
  id                  String             @id @default(uuid())
  batchId             String             @map("batch_id")
  executedAt          DateTime           @default(now()) @map("executed_at")
  studentId           String?            @map("student_id")
  nama                String
  cabangId            String?            @map("cabang_id")
  cabangName          String?            @map("cabang_name")
  wilayahName         String?            @map("wilayah_name")
  lembagaMuadalahName String?            @map("lembaga_muadalah_name")
  tingkat             String?
  kelasName           String?            @map("kelas_name")
  nisnEsantri         String?            @map("nisn_esantri")
  nikEsantri          String?            @map("nik_esantri")
  tempatLahirEsantri  String?            @map("tempat_lahir_esantri")
  tanggalLahirEsantri String?            @map("tanggal_lahir_esantri")
  jenisKelaminEsantri String?            @map("jenis_kelamin_esantri")

  statusEmis          String             @map("status_emis")
  emisId              String?            @map("emis_id")
  nisnEmis            String?            @map("nisn_emis")
  rombelEmis          String?            @map("rombel_emis")
  sourceLembagaEmis   String?            @map("source_lembaga_emis")

  statusVerval        String             @map("status_verval")
  vervalPdId          String?            @map("verval_pd_id")
  nisnVerval          String?            @map("nisn_verval")
  residuDetail        Json?              @map("residu_detail")

  butuhTindakan       Boolean            @default(false) @map("butuh_tindakan")
  discrepancies       String[]           @default([])
  rekomendasiTindakan String?            @map("rekomendasi_tindakan")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  batch               KomparasiEmisBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student             Student?           @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([batchId])
  @@index([cabangId])
  @@index([statusEmis])
  @@index([statusVerval])
  @@index([butuhTindakan])
  @@map("komparasi_emis")
  @@schema("formal")
}
