model Wilayah {
  id                 String             @id @default(uuid())
  name               String
  ketuaMuadalahId    String?            @map("ketua_muadalah_id")
  ketuaMuadalahName  String?            @map("ketua_muadalah_name")
  ketuaMuadalahPhone String?            @map("ketua_muadalah_phone")
  cabangs            Cabang[]
  staff              Staff[]
  students           Student[]
  users              User[]
  kelasDaimi         KelasDaimi[]
  permohonanCabang   PermohonanCabang[]
  permohonanKelas    PermohonanKelas[]

  @@map("wilayah")
  @@schema("core")
}

model Cabang {
  id                        String                @id @default(uuid())
  name                      String
  wilayahId                 String?               @map("wilayah_id")
  kapasitasSantri           Int?                  @default(0) @map("kapasitas_santri")
  nameGlodemy               String?               @map("name_glodemy")
  nameResmi                 String?               @map("name_resmi")
  totalSantriManual         Int?                  @default(0) @map("total_santri_manual")
  alamatJalan               String?               @map("alamat_jalan")
  alamatKabId               String?               @map("alamat_kab_id")
  alamatKabName             String?               @map("alamat_kab_name")
  alamatKecId               String?               @map("alamat_kec_id")
  alamatKecName             String?               @map("alamat_kec_name")
  alamatKelId               String?               @map("alamat_kel_id")
  alamatKelName             String?               @map("alamat_kel_name")
  alamatProvId              String?               @map("alamat_prov_id")
  alamatProvName            String?               @map("alamat_prov_name")
  ketuaCabangId             String?               @map("ketua_cabang_id")
  ketuaIslerId              String?               @map("ketua_isler_id")
  ketuaMuadalahId           String?               @map("ketua_muadalah_id")
  statusBangunan            String?               @map("status_bangunan")
  statusTanah               String?               @map("status_tanah")
  alamatNegara              String?               @map("alamat_negara")
  urlGoogleMaps             String?               @map("url_google_maps")
  fotoPlang                 String?               @map("foto_plang")
  fotoGedung                String?               @map("foto_gedung")
  fotoHalaman               String?               @map("foto_halaman")
  fotoDenah                 String?               @map("foto_denah")
  fotoMushala               String?               @map("foto_mushala")
  fotoKelas                 String?               @map("foto_kelas")
  fotoRuangTidur            String?               @map("foto_ruang_tidur")
  fotoRuangMakan            String?               @map("foto_ruang_makan")
  fotoKamarMandi            String?               @map("foto_kamar_mandi")
  wilayah                   Wilayah?              @relation(fields: [wilayahId], references: [id])
  permintaanTarikRequesting PermintaanTarikData[] @relation("RequestingCabang")
  permintaanTarikTarget     PermintaanTarikData[] @relation("TargetCabang")
  riwayatPendidikan         RiwayatPendidikan[]
  staff                     Staff[]
  students                  Student[]
  users                     User[]
  kelas                     Kelas[]
  kelasDaimi                KelasDaimi[]
  ruang                     Ruang[]
  fasilitas                 Fasilitas[]
  kegiatan                  Kegiatan[]
  grupDaimi                 GrupDaimi[]           @relation("GrupDaimiCabang")
  permohonanKelas           PermohonanKelas[]
  targetKuota               TargetKuotaCabang[]
  cctvChannels              CctvChannel[]

  @@map("cabang")
  @@schema("core")
}

model Faq {
  id        String   @id @default(uuid())
  question  String
  answer    String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("faq")
  @@schema("core")
}

model User {
  id                       String                 @id @default(uuid())
  username                 String                 @unique
  password                 String
  scope                    UserScope
  divisi                   UserDivisi
  wilayahId                String?                @map("wilayah_id")
  cabangId                 String?                @map("cabang_id")
  operatorName             String?                @map("operator_name")
  twoFactorEnabled         Boolean                @default(false) @map("two_factor_enabled")
  twoFactorSecret          String?                @map("two_factor_secret")
  twoFactorBackupCodes     String[]               @default([]) @map("two_factor_backup_codes")
  cabang                   Cabang?                @relation(fields: [cabangId], references: [id])
  wilayah                  Wilayah?               @relation(fields: [wilayahId], references: [id])
  confirmedKegiatan        Kegiatan[]
  permohonanCabangCreated  PermohonanCabang[]     @relation("PermohonanCabangCreatedBy")
  permohonanCabangApproved PermohonanCabang[]     @relation("PermohonanCabangApprovedBy")
  permohonanKelasCreated   PermohonanKelas[]      @relation("PermohonanKelasCreatedBy")
  permohonanKelasApproved  PermohonanKelas[]      @relation("PermohonanKelasApprovedBy")
  letters                  Letter[]
  templates                Template[]
  waliSantri               WaliSantri[]
  permohonanIzinCreated    PermohonanIzinSantri[] @relation("PermohonanIzinCreatedBy")
  permohonanIzinApproved   PermohonanIzinSantri[] @relation("PermohonanIzinApprovedBy")

  @@map("users")
  @@schema("core")
}

model Biodata {
  id                    String    @id @default(uuid())
  nik                   String?   @unique
  noKk                  String?   @map("no_kk")
  nisLokal              String?   @map("nis_lokal")
  noGlodemy             String?   @map("no_glodemy")
  fullName              String    @map("full_name")
  tempatLahir           String?   @map("tempat_lahir")
  tanggalLahir          DateTime? @map("tanggal_lahir")
  jenisKelamin          String?   @map("jenis_kelamin")
  kewarganegaraan       String?   @map("kewarganegaraan")
  jumlahSaudara         Int?      @map("jumlah_saudara")
  anakKe                Int?      @map("anak_ke")
  namaAyah              String?   @map("nama_ayah")
  statusHidupAyah       String?   @map("status_hidup_ayah")
  nikAyah               String?   @map("nik_ayah")
  tempatLahirAyah       String?   @map("tempat_lahir_ayah")
  tanggalLahirAyah      DateTime? @map("tanggal_lahir_ayah")
  pekerjaanAyah         String?   @map("pekerjaan_ayah")
  pendidikanAyah        String?   @map("pendidikan_ayah")
  penghasilanAyah       String?   @map("penghasilan_ayah")
  namaIbu               String?   @map("nama_ibu")
  statusHidupIbu        String?   @map("status_hidup_ibu")
  nikIbu                String?   @map("nik_ibu")
  tempatLahirIbu        String?   @map("tempat_lahir_ibu")
  tanggalLahirIbu       DateTime? @map("tanggal_lahir_ibu")
  pekerjaanIbu          String?   @map("pekerjaan_ibu")
  pendidikanIbu         String?   @map("pendidikan_ibu")
  penghasilanIbu        String?   @map("penghasilan_ibu")
  address               String?
  phone                 String?
  kontakDaruratNama     String?   @map("kontak_darurat_nama")
  kontakDaruratTelp     String?   @map("kontak_darurat_telp")
  kontakDaruratHubungan String?   @map("kontak_darurat_hubungan")
  fotoUrl               String?   @map("foto_url")
  ijazahUrl             String?   @map("ijazah_url")
  kkUrl                 String?   @map("kk_url")
  akteUrl               String?   @map("akte_url")
  suratMutasiUrl        String?   @map("surat_mutasi_url")
  raporUrl              String?   @map("rapor_url")
  skhunUrl              String?   @map("skhun_url")
  suratKesehatanUrl     String?   @map("surat_kesehatan_url")
  suratDomisiliUrl      String?   @map("surat_domisili_url")
  dokumenLainUrl        String?   @map("dokumen_lain_url")
  nisn                  String?   @unique @map("nisn")
  alamatJalan           String?   @map("alamat_jalan")
  alamatKabId           String?   @map("alamat_kab_id")
  alamatKabName         String?   @map("alamat_kab_name")
  alamatKecId           String?   @map("alamat_kec_id")
  alamatKecName         String?   @map("alamat_kec_name")
  alamatKelId           String?   @map("alamat_kel_id")
  alamatKelName         String?   @map("alamat_kel_name")
  alamatProvId          String?   @map("alamat_prov_id")
  alamatProvName        String?   @map("alamat_prov_name")
  student               Student?

  @@map("biodata")
  @@schema("core")
}

model Student {
  id                     String                 @id @default(uuid())
  biodataId              String                 @unique @map("biodata_id")
  wilayahId              String?                @map("wilayah_id")
  cabangId               String?                @map("cabang_id")
  statusPool             StatusPool             @default(TERSEDIA) @map("status_pool")
  isActive               Boolean                @default(true) @map("is_active")
  jenisSiswa             JenisSiswa?            @map("jenis_siswa")
  grupDaimi              String?                @map("grup_daimi")
  statusHafidz           StatusHafidz?          @map("status_hafidz")
  daftarUlangAt          DateTime?              @map("daftar_ulang_at")
  daftarUlangJenis       String?                @map("daftar_ulang_jenis")
  daftarUlangTahunAjaran String?                @map("daftar_ulang_tahun_ajaran")
  daftarUlangSemester    String?                @map("daftar_ulang_semester")
  kehadiran              Kehadiran[]
  permintaanTarik        PermintaanTarikData[]
  riwayatPendidikan      RiwayatPendidikan[]
  biodata                Biodata                @relation(fields: [biodataId], references: [id])
  cabang                 Cabang?                @relation(fields: [cabangId], references: [id])
  wilayah                Wilayah?               @relation(fields: [wilayahId], references: [id])
  riwayatKelasFormal     RiwayatKelasFormal[]
  siswaFormal            SiswaFormal?
  dataDaimi              DataDaimi?
  nilaiFormal            NilaiFormal[]
  hafalanAlQuran         HafalanAlQuran[]
  absensiMapel           AbsensiMapel[]
  waliSantri             WaliSantri[]
  permohonanIzin         PermohonanIzinSantri[]

  @@map("students")
  @@schema("core")
}

model RiwayatPendidikan {
  id            String    @id @default(uuid())
  studentId     String    @map("student_id")
  cabangId      String?   @map("cabang_id")
  tanggalMasuk  DateTime  @map("tanggal_masuk")
  tanggalKeluar DateTime? @map("tanggal_keluar")
  statusAkhir   String?   @map("status_akhir")
  catatan       String?
  cabang        Cabang?   @relation(fields: [cabangId], references: [id])
  student       Student   @relation(fields: [studentId], references: [id])

  @@map("riwayat_pendidikan")
  @@schema("core")
}

model Staff {
  id                 String               @id @default(uuid())
  name               String
  position           String
  wilayahId          String?              @map("wilayah_id")
  cabangId           String?              @map("cabang_id")
  grupDaimiId        String?              @map("grup_daimi_id")
  ifadahUrl          String?              @map("ifadah_url")
  ktpUrl             String?              @map("ktp_url")
  ijazahUrl          String?              @map("ijazah_url")
  jenisKelamin       String?              @map("jenis_kelamin")
  pendidikanTerakhir String?              @map("pendidikan_terakhir")
  perguruanTinggi    String?              @map("perguruan_tinggi")
  programStudi       String?              @map("program_studi")
  tahunLulus         String?              @map("tahun_lulus")
  nik                String?              @map("nik")
  tempatLahir        String?              @map("tempat_lahir")
  tanggalLahir       DateTime?            @map("tanggal_lahir")
  statusPool         StatusPool           @default(TERSEDIA) @map("status_pool")
  phone              String?              @map("phone")
  mapelUmum          String[]             @map("mapel_umum")
  waliKelas          String?              @map("wali_kelas")
  cabang             Cabang?              @relation(fields: [cabangId], references: [id])
  grupDaimi          GrupDaimi?           @relation(fields: [grupDaimiId], references: [id])
  grupDaimiKetua     GrupDaimi[]          @relation("GrupDaimiKetua")
  wilayah            Wilayah?             @relation(fields: [wilayahId], references: [id])
  guruMapelKelas     GuruMapelKelas[]
  pelaksanaanSilabus PelaksanaanSilabus[]
  riwayatWaliKelas   RiwayatKelasFormal[]
  kelasWali          Kelas[]              @relation("KelasWali")
  panitia            Panitia[]
  kehadiranGuru      KehadiranGuru[]

  @@map("staff")
  @@schema("core")
}

model PengaturanAkademik {
  id              String   @id @default(uuid())
  semesterAktif   String   @map("semester_aktif")
  tahunAjaran     String   @map("tahun_ajaran")
  kodeDaftarUlang String?  @map("kode_daftar_ulang")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("pengaturan_akademik")
  @@schema("core")
}

model Pengumuman {
  id        String   @id @default(uuid())
  title     String
  content   String
  links     Json?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  showPopup Boolean  @default(false) @map("show_popup")

  @@map("pengumuman")
  @@schema("core")
}

model KalenderAkademik {
  id        String   @id @default(uuid())
  title     String
  fileUrl   String   @map("file_url")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("kalender_akademik")
  @@schema("core")
}

model PermintaanTarikData {
  id                 String                @id @default(uuid())
  studentId          String                @map("student_id")
  requestingCabangId String                @map("requesting_cabang_id")
  targetCabangId     String?               @map("target_cabang_id")
  status             StatusPermintaanTarik @default(PENDING)
  alasan             String?
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  requestingCabang   Cabang                @relation("RequestingCabang", fields: [requestingCabangId], references: [id])
  student            Student               @relation(fields: [studentId], references: [id])
  targetCabang       Cabang?               @relation("TargetCabang", fields: [targetCabangId], references: [id])

  @@map("permintaan_tarik_data")
  @@schema("core")
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  entity     String
  entityId   String   @map("entity_id")
  entityName String   @map("entity_name")
  actorId    String   @map("actor_id")
  actorName  String   @map("actor_name")
  actorScope String   @map("actor_scope")
  wilayahId  String?  @map("wilayah_id")
  cabangId   String?  @map("cabang_id")
  details    String
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
  @@schema("core")
}

enum UserScope {
  GLOBAL
  WILAYAH
  CABANG
  WALI
  AUDITOR

  @@schema("core")
}

enum UserDivisi {
  FORMAL
  PESANTREN
  ALL

  @@schema("core")
}

enum StatusPool {
  TERSEDIA
  AKTIF_CABANG
  LULUS
  MUTASI
  DROP_OUT

  @@schema("core")
}

enum JenisSiswa {
  MUADALAH
  NON_MUADALAH

  @@schema("core")
}

enum StatusHafidz {
  BELUM_MULAI
  SEDANG_BERLANGSUNG
  SUDAH_SETOR_30_JUZ
  SUDAH_KHATAMAN_KUBRO

  @@schema("core")
}

enum StatusPermintaanTarik {
  PENDING
  APPROVED
  REJECTED

  @@schema("core")
}

enum StatusPermohonan {
  PENDING
  APPROVED
  REJECTED

  @@schema("core")
}

model PermohonanCabang {
  id               String           @id @default(uuid())
  wilayahId        String           @map("wilayah_id")
  namaCabangUsulan String           @map("nama_cabang_usulan")
  alamatJalan      String?          @map("alamat_jalan")
  alamatKabName    String?          @map("alamat_kab_name")
  alamatProvName   String?          @map("alamat_prov_name")
  kapasitasSantri  Int?             @default(0) @map("kapasitas_santri")
  alasan           String?
  catatanAdmin     String?          @map("catatan_admin")
  status           StatusPermohonan @default(PENDING)
  createdById      String           @map("created_by_id")
  approvedById     String?          @map("approved_by_id")
  cabangCreatedId  String?          @map("cabang_created_id")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  wilayah    Wilayah @relation(fields: [wilayahId], references: [id])
  createdBy  User    @relation("PermohonanCabangCreatedBy", fields: [createdById], references: [id])
  approvedBy User?   @relation("PermohonanCabangApprovedBy", fields: [approvedById], references: [id])

  @@map("permohonan_cabang")
  @@schema("core")
}

model TargetKuotaCabang {
  id              String   @id @default(uuid())
  cabangId        String   @map("cabang_id")
  tahunAjaran     String   @default("2026/2027") @map("tahun_ajaran")
  
  // Target per Grup Daimi
  targetHazirlik  Int      @default(0) @map("target_hazirlik")
  targetHafizlik  Int      @default(0) @map("target_hafizlik")
  targetIbtidai   Int      @default(0) @map("target_ibtidai")
  targetIhzari    Int      @default(0) @map("target_ihzari")

  // Target per Tingkat Formal
  targetTingkat7  Int      @default(0) @map("target_tingkat_7")
  targetTingkat8  Int      @default(0) @map("target_tingkat_8")
  targetTingkat9  Int      @default(0) @map("target_tingkat_9")
  targetTingkat10 Int      @default(0) @map("target_tingkat_10")
  targetTingkat11 Int      @default(0) @map("target_tingkat_11")
  targetTingkat12 Int      @default(0) @map("target_tingkat_12")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  cabang          Cabang   @relation(fields: [cabangId], references: [id], onDelete: Cascade)

  @@unique([cabangId, tahunAjaran])
  @@map("target_kuota_cabang")
  @@schema("core")
}
