model JenisKegiatan {
  id        String             @id @default(uuid())
  nama      String             @unique
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  templates TemplateKegiatan[]

  @@map("jenis_kegiatan")
  @@schema("core")
}

model TemplateKegiatan {
  id                String            @id @default(uuid())
  judul             String
  deskripsi         String?
  deadline          DateTime
  jenisId           String            @map("jenis_id")
  tanggalKegiatan   DateTime?         @map("tanggal_kegiatan")
  waktuKegiatan     String?           @map("waktu_kegiatan")
  tujuanKegiatan    String?           @map("tujuan_kegiatan")
  tema              String?           @map("tema")
  latarBelakang     String?           @map("latar_belakang")
  bentukKegiatan    String?           @map("bentuk_kegiatan")
  rangkaianKegiatan String?           @map("rangkaian_kegiatan")
  hasilPelaksanaan  String?           @map("hasil_pelaksanaan")
  penutup           String?           @map("penutup")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  jenis             JenisKegiatan     @relation(fields: [jenisId], references: [id])
  kegiatan          Kegiatan[]
  dokumen           DokumenTemplate[]

  @@map("template_kegiatan")
  @@schema("core")
}

model DokumenTemplate {
  id         String           @id @default(uuid())
  templateId String           @map("template_id")
  filePath   String           @map("file_path")
  fileName   String           @map("file_name")
  fileType   String           @map("file_type") // DOCUMENT, PHOTO
  createdAt  DateTime         @default(now()) @map("created_at")

  template   TemplateKegiatan @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("dokumen_template")
  @@schema("core")
}

model Kegiatan {
  id                String            @id @default(uuid())
  templateId        String            @map("template_id")
  cabangId          String            @map("cabang_id")
  asramaId          String?           @map("asrama_id")
  deskripsi         String?           // Deskripsi pelaksanaan oleh cabang
  tanggalKegiatan   DateTime?         @map("tanggal_kegiatan")
  waktuKegiatan     String?           @map("waktu_kegiatan")
  tempatKegiatan    String?           @map("tempat_kegiatan")
  jumlahPeserta     Int?              @map("jumlah_peserta")
  totalSantri       Int?              @map("total_santri")
  totalGuru         Int?              @map("total_guru")
  ringkasanKegiatan String?           @map("ringkasan_kegiatan")
  kesimpulan        String?           @map("kesimpulan")
  evaluasiBaik      String?           @map("evaluasi_baik")
  evaluasiPerbaikan String?           @map("evaluasi_perbaikan")
  bentukKegiatan    String?           @map("bentuk_kegiatan")
  rangkaianKegiatan String?           @map("rangkaian_kegiatan")
  hasilPelaksanaan  String?           @map("hasil_pelaksanaan")
  
  // Konfirmasi oleh Pusat
  isConfirmed       Boolean           @default(false) @map("is_confirmed")
  confirmedAt       DateTime?         @map("confirmed_at")
  confirmedByUserId String?           @map("confirmed_by_user_id")

  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  template          TemplateKegiatan  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  cabang            Cabang            @relation(fields: [cabangId], references: [id], onDelete: Cascade)
  asrama            Ruang?            @relation(fields: [asramaId], references: [id], onDelete: SetNull)
  confirmedByUser   User?             @relation(fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  panitia           Panitia[]
  dokumen           DokumenKegiatan[]

  @@map("kegiatan")
  @@schema("core")
}

model Panitia {
  id         String   @id @default(uuid())
  kegiatanId String   @map("kegiatan_id")
  staffId    String   @map("staff_id")
  jabatan    String   // KETUA
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  kegiatan   Kegiatan @relation(fields: [kegiatanId], references: [id], onDelete: Cascade)
  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("panitia")
  @@schema("core")
}

model DokumenKegiatan {
  id         String   @id @default(uuid())
  kegiatanId String   @map("kegiatan_id")
  filePath   String   @map("file_path")
  fileName   String   @map("file_name")
  fileType   String   @map("file_type") // DOCUMENT, PHOTO
  createdAt  DateTime @default(now()) @map("created_at")

  kegiatan   Kegiatan @relation(fields: [kegiatanId], references: [id], onDelete: Cascade)

  @@map("dokumen_kegiatan")
  @@schema("core")
}

model RekapKegiatan {
  id                String   @id @default(uuid())
  templateId        String   @default("ALL") @map("template_id") // 'ALL' jika agregat seluruh template
  
  // Hirarki Agregat
  groupType         String   @map("group_type")  // 'CABANG' | 'WILAYAH' | 'LEMBAGA' | 'GLOBAL'
  groupId           String   @map("group_id")    // cabangId, wilayahId, lembagaId, atau 'GLOBAL'
  groupName         String   @map("group_name")
  parentGroupId     String?  @map("parent_group_id") // misal wilayahId untuk cabang
  
  // Metrik Agregat
  totalCabang       Int      @default(0) @map("total_cabang")
  activeCabangCount Int      @default(0) @map("active_cabang_count")
  totalBapSubmitted Int      @default(0) @map("total_bap_submitted")
  totalBapConfirmed Int      @default(0) @map("total_bap_confirmed")
  totalBapPending   Int      @default(0) @map("total_bap_pending")
  totalSantri       Int      @default(0) @map("total_santri")
  totalGuru         Int      @default(0) @map("total_guru")
  totalPeserta      Int      @default(0) @map("total_peserta")
  completionRate    Float    @default(0) @map("completion_rate")
  status            String   @default("BELUM_ADA") // 'SELESAI' | 'SEBAGIAN' | 'BELUM_ADA'
  
  // Metadata tambahan jika perlu (misal daftar lembaga cabang)
  extraData         Json?    @map("extra_data")
  
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([templateId, groupType, groupId])
  @@index([groupType, groupId])
  @@index([templateId])
  @@map("rekap_kegiatan")
  @@schema("core")
}

